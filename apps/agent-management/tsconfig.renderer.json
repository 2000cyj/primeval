{
  // 渲染层(Vue3 + TS)的类型检查,继承仓库根基础配置
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // Vue3 SFC 使用 jsdom/浏览器环境，且需保留原始 JSX 交由 vue 编译器处理
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "useDefineForClassFields": true,
    "sourceMap": true,

    // 严格类型校验
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    // 允许通过 @/* 引用渲染层 src 下模块
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/renderer/src/*"]
    },

    // 应用不产出类型声明，交由打包器处理
    "noEmit": true
  },
  "include": [
    "src/renderer/src/**/*.ts",
    "src/renderer/src/**/*.d.ts",
    "src/renderer/src/**/*.tsx",
    "src/renderer/src/**/*.vue"
  ]
}
