{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@remote/agent-management#build": {
      "dependsOn": ["^build"],
      "outputs": ["out/**", "release/**"]
    },
    "@remote/agent-management#typecheck": {
      "dependsOn": ["^build"]
    },
    "@remote/agent-data-grid#build": {
      "dependsOn": ["^build"],
      "outputs": ["out/**", "release/**"]
    },
    "@remote/agent-data-grid#typecheck": {
      "dependsOn": ["^build"]
    },
    "@remote/agent-compose#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "src-tauri/bin/**"],
      "cache": false
    },
    "lint": {},
    "lint:fix": {},
    "format": {
      "cache": false
    },
    "format:check": {},
    "lint:spelling": {
      "cache": false
    },
    "commit": {
      "cache": false
    },
    "commit:lint": {
      "cache": false
    }
  }
}
